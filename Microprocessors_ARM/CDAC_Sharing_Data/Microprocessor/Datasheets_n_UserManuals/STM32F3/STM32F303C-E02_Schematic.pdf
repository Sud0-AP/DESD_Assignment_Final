ads[3]\), Math.max\(quads[5], quads[7]\)\);              \r\n    if \(\(left >= qRight\) || \(right <= qLeft\) || \(top >= qBottom\) || \(bottom <= qTop\)\) continue;      \r\n   \ var dist =   Math.abs\(left - qLeft\) + Math.abs\(right - qRight\)                                   \r\n               + Math.abs\(top - qTop\) + Math.abs\(bottom - qBottom\);                                  \r\n    if \(\(lastDist >= 0\) && \(lastDist\ <= dist\)\) continue;                                             \r\n    lastDist = dist;                                                                                 \r\n    lastIndex = i;                                                             \                      \r\n}                                                                                                    \r\nif \(lastIndex >= 0\) this.selectPageNthWord\(pageIndex, lastIndex, bScroll=false\);                     })/S/JavaScript>>endobj391 0 obj<</JS(function ShowCompProps_88FE0CB68B0C498A9AC940B213575EC2\(\){var sChoice = app.popUpMenu\("Simulation: ","Signal Integrity: Connector","Publisher: Altium Limited","PCB3D: ","Library Reference: Header 25X2","Library Name: Miscellaneous Connectors.IntLib","L\atestRevisionNote: Re-released for DXP Platform.","LatestRevisionDate: 17-Jul-2002","Ibis Model: ","Footprint: HEAD25X2/2.54","Description: Header, 25-Pin, Dual row","Component Kind: Standard","Comment: Header 25X2"\); if \(sChoice\) {var nUrlPos = sChoic\e.search\(/:\\s\(\(http|https|ftp\):\\/\\/\).+/\); if \(nUrlPos !== -1\) {app.launchURL\(sChoice.substr\(nUrlPos+2\), true\);} else {var nPathPos = sChoice.search\(/:\\s\(\(\\/\)|\(\\\\\\\\\)\).+/\); if \(nPathPos !== -1\) app.openDoc\(sChoice.substr\(nPa\thPos+2\)\);};};})/S/JavaScript>>endobj392 0 obj<</JS(function ShowCompProps_AD8DC441834D407EB349ECC6F10D02F3\(\){var sChoice = app.popUpMenu\("Simulation: ","Signal Integrity: Connector","Publisher: Altium Limited","PCB3D: ","Library Reference: Header 2